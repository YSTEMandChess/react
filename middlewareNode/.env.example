# middlewareNode environment variables
#
# HOW TO USE (local dev):
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values in .env  (NEVER commit .env — it is gitignored)
#   3. Start the server so dotenv loads before anything else, e.g.:
#        node -r dotenv/config src/server.js
#      (server.js now also calls dotenv at startup, so `node src/server.js` works too)
#
# The names below are the ones mapped in config/custom-environment-variables.json.
# In production these same names are injected by deploy/prod/docker-compose.yml
# (from the host env or a deploy/prod/.env), NOT from this file.

# --- Core ---
MONGO_URI=
JWT_SECRET=
INDEX_KEY=
CORS_ORIGIN=
BASEPATH=
PORT=8000

# --- Email / Google OAuth ---
EMAIL_USER=
EMAIL_PASS=
SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# --- Azure Blob Storage (meeting recordings + avatars) ---
# Account name is the <account> in https://<account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
# Agora storageConfig region code for Azure. Azure resolves the physical region
# from the account name, so this is 0 (see Agora region-vendor reference).
AZURE_STORAGE_REGION=0

# --- Agora (video + cloud recording) ---
AGORA_APP_ID=
AGORA_UID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_CERT=
